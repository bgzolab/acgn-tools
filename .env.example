# 这些变量由 acgn-server 从「进程环境」读取（不解析 .env 文件）。
# 用法：`set -a; source .env; set +a; cargo run -p acgn-server -- serve`
# 或交给 systemd 的 EnvironmentFile / docker 的 --env-file。

# ---- 服务 ----
# 监听地址（默认只监听本机；要让局域网 / 服务器访问改成 0.0.0.0:8787）
ACGN_BIND=127.0.0.1:8787
# SQLite 文件路径（默认 ./data/acgn.db）
ACGN_DB=./data/acgn.db
# 前端构建产物目录（存在时同端口托管）
ACGN_WEB_DIR=./web/dist
# 日志过滤规则
ACGN_LOG=info,acgn_server=debug,acgn_steam=debug,acgn_store=debug
# 跨域白名单（逗号分隔）。同源部署与 Vite 代理都不需要 CORS；
# 只有在「前端部署在别的域名」时才需要显式放行
# ACGN_CORS_ORIGINS=https://acgn.example.com

# ---- Steam ----
# 可选：有 Key 时，公开愿望单接口被拒会回退官方接口
# STEAM_API_KEY=
# 商店国家（决定价格币种）与语言（决定简介 / 名字语言）
STEAM_COUNTRY=cn
STEAM_LANGUAGE=schinese

# ---- 离线模式 ----
# 指向 fixtures/steam 即完全不发网络请求，适合演示与回归测试
# ACGN_STEAM_FIXTURE=fixtures/steam

# ---- 出网代理（可选，reqwest 会自动读取这些变量）----
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890
